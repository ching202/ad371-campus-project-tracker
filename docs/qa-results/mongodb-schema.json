{
  "version": "8.0.38",
  "projects": 0,
  "collections": [
    {
      "name": "projects",
      "type": "collection",
      "options": {
        "validator": {
          "$and": [
            {
              "$jsonSchema": {
                "bsonType": "object",
                "required": [
                  "_id",
                  "title",
                  "description",
                  "tasks",
                  "created_at",
                  "updated_at"
                ],
                "additionalProperties": false,
                "properties": {
                  "_id": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "title": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "\\S"
                  },
                  "description": {
                    "bsonType": "string",
                    "maxLength": 2000
                  },
                  "created_at": {
                    "bsonType": "date"
                  },
                  "updated_at": {
                    "bsonType": "date"
                  },
                  "tasks": {
                    "bsonType": "array",
                    "maxItems": 100,
                    "items": {
                      "bsonType": "object",
                      "required": [
                        "id",
                        "title",
                        "status",
                        "created_at",
                        "updated_at"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "bsonType": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "title": {
                          "bsonType": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "\\S"
                        },
                        "status": {
                          "enum": [
                            "todo",
                            "in_progress",
                            "done"
                          ]
                        },
                        "created_at": {
                          "bsonType": "date"
                        },
                        "updated_at": {
                          "bsonType": "date"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "$expr": {
                "$cond": {
                  "if": {
                    "$isArray": "$tasks"
                  },
                  "then": {
                    "$eq": [
                      {
                        "$size": "$tasks"
                      },
                      {
                        "$size": {
                          "$setUnion": [
                            {
                              "$map": {
                                "input": "$tasks",
                                "as": "task",
                                "in": "$$task.id"
                              }
                            },
                            []
                          ]
                        }
                      }
                    ]
                  },
                  "else": false
                }
              }
            }
          ]
        },
        "validationLevel": "strict",
        "validationAction": "error"
      },
      "info": {
        "readOnly": false,
        "uuid": "2147a399-378f-459d-8ff2-08f4caf49ac7"
      },
      "idIndex": {
        "v": 2,
        "key": {
          "_id": 1
        },
        "name": "_id_"
      }
    }
  ],
  "indexes": [
    {
      "v": 2,
      "key": {
        "_id": 1
      },
      "name": "_id_"
    },
    {
      "v": 2,
      "key": {
        "created_at": -1,
        "_id": -1
      },
      "name": "created_at_-1__id_-1"
    }
  ]
}
